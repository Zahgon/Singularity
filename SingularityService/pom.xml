  <properties>
    <!-- The module takes the library versions the new framework manages rather than the ones the parent
         project pins for the modules that stay on the old one, so the parent's check that every module
         agrees on a version does not apply to it. -->
    <basepom.check.skip-dependency-versions-check>true</basepom.check.skip-dependency-versions-check>
    <basepom.check.skip-dependency-management>true</basepom.check.skip-dependency-management>
    <!-- The parent project's dependency analysis reads class files with a reader that does not know
         the class format of the JDK this module is built for. -->
    <basepom.check.skip-dependency>true</basepom.check.skip-dependency>
    <!-- The parent project's bug finder cannot read them either. -->
    <basepom.check.skip-findbugs>true</basepom.check.skip-findbugs>
    <!-- Nor can its source analyser, which knows no newer language level than the parent's. -->
    <basepom.check.skip-pmd>true</basepom.check.skip-pmd>
    <!-- Spring Boot needs Java 17; the rest of the reactor keeps the JDK the root pom targets. -->
    <project.build.targetJdk>17</project.build.targetJdk>
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- The logging libraries the new framework is built against; the modules that stay on the old
         framework keep the ones the parent project pins. -->
    <!-- The object graph is built by a line of the injector that reads the class format of the JDK
         this module is built for. -->
    <!-- The line of the state store's client that runs on the JDK this module is built for, and the
         line of its embedded server that goes with it, for this module alone. -->
    <dep.zookeeper.version>3.5.10</dep.zookeeper.version>
    <!-- The line of the serialisation library the new framework needs, for this module alone. -->
    <dep.jackson-databind.version>2.19.4</dep.jackson-databind.version>
    <dep.jackson.version>2.19.4</dep.jackson.version>
    <dep.guice.version>5.1.0</dep.guice.version>
    <dep.logback.version>1.5.34</dep.logback.version>
    <dep.slf4j.version>2.0.18</dep.slf4j.version>
    <springdoc.version>2.8.17</springdoc.version>
    <mustache.version>0.9.14</mustache.version>
    <argparse4j.version>0.8.1</argparse4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The test framework the repository pins, imported ahead of the new framework's own bill of
           materials so that the module's tests go on running on the line they were written for: the first
           import of a managed version is the one that holds. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${dep.junit-jupiter.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- The line of the serialisation library the new framework needs, for this module alone; the modules
           that stay on the old framework keep the one the parent project pins. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.19.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- The YAML reader the serialisation library of this module needs; the modules that stay on the
           old framework keep the one the parent project pins. -->
      <dependency>
        <groupId>org.yaml</groupId>
        <artifactId>snakeyaml</artifactId>
        <version>2.4</version>
      </dependency>
      <!-- The embedded state store the module's own tests start: the line that goes with the ZooKeeper
           client this module takes, because the older line's server does not run on the JDK this module is
           built for. The modules that stay on the old framework keep the line the parent project pins. -->
      <dependency>
        <groupId>org.apache.curator</groupId>
        <artifactId>curator-test</artifactId>
        <version>${dep.curator.version}</version>
        <exclusions>
          <exclusion>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
          </exclusion>
          <exclusion>
            <groupId>log4j</groupId>
            <artifactId>log4j</artifactId>
          </exclusion>
          <exclusion>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-log4j12</artifactId>
          </exclusion>
          <exclusion>
            <groupId>org.apache.zookeeper</groupId>
            <artifactId>zookeeper</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
    </dependencies>
  </dependencyManagement>

